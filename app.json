{
  "expo": {
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "androidMode": "default",
          "androidCollapsedTitle": "Mind & Motion"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite"
    ],
    "name": "Mind & Motion",
    "slug": "mindandmotion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Mind&Motion использует Face ID для входа в приложение."
      }
    },
    "android": {
      "package": "com.bragin22.mindandmotionmobile.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "efa67276-4a28-4c36-94e4-73220f0e5bd0"
      }
    }
  }
}
