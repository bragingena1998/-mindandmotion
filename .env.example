# MindAndMotion — пример переменных окружения
# Скопируй в .env и заполни реальными значениями
# НИКОГДА не коммить .env с реальными данными!

# ==============================
# SERVER
# ==============================
PORT=3000
NODE_ENV=development

# ==============================
# DATABASE (MySQL / beget.app)
# ==============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindandmotion
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ==============================
# JWT AUTH
# ==============================
JWT_SECRET=generate_with_node_crypto_randomBytes_64
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate_another_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ==============================
# FRONTEND URL (CORS)
# ==============================
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://yourdomain.ru

# ==============================
# TELEGRAM BOT (для approve workflow)
# ==============================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ==============================
# EMAIL / SMTP (если используется)
# ==============================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password

# ==============================
# PUSH NOTIFICATIONS (FCM)
# ==============================
# FCM_SERVER_KEY=your_fcm_server_key
# EXPO_ACCESS_TOKEN=your_expo_token

# ==============================
# EXTERNAL APIs
# ==============================
# OPENAI_API_KEY=sk-...
